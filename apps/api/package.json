{
  "name": "cliente-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check-db": "tsx src/server.ts --check-database",
    "review": "tsx src/server.ts --review"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "luxon": "3.7.2",
    "mssql": "12.7.4",
    "multer": "2.4.0",
    "nodemailer": "^10.0.16",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.1",
    "@types/mssql": "^9.1.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "fflate": "0.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
