APP_ENV=Production
PORT=5180
BIND_ADDRESS=127.0.0.1
ALLOWED_HOSTS=care.app-tranie.io.vn;care.tranie-mua.io.vn;localhost;127.0.0.1
TRUST_LOCAL_PROXY=true
REVIEW_ENABLED=false

# Optional separate Admin PWA. Set both after adding the Admin Tunnel hostname.
# Keep the existing care.tranie-mua.io.vn route and VAPID keys.
# USER_APP_URL=https://care.tranie-mua.io.vn
# ADMIN_APP_URL=https://admin-care.tranie-mua.io.vn

DB_SERVER=172.20.235.176
DB_PORT=1433
DB_NAME=MEC
DB_USER=mec_app
DB_PASSWORD='CHANGE_ON_SERVER'
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# DB_CERTIFICATE_HOST=sql.example.internal

STORAGE_PATH=/var/lib/cliente/photos
PUSH_ENABLED=false
PUSH_SUBJECT='mailto:admin@example.com'
PUSH_PUBLIC_KEY=''
PUSH_PRIVATE_KEY=''

# Gmail SMTP / email verification. Keep the app password only in the server .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=robotics.gitlab.2fa@gmail.com
SMTP_FROM=robotics.gitlab.2fa@gmail.com
SMTP_PASS=''
