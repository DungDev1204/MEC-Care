[Unit]
Description=Cliente web app and reminder worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cliente
Group=cliente
WorkingDirectory=/opt/cliente/current
ExecStartPre=/opt/cliente/node/bin/node /opt/cliente/current/dist/server.js --check-database
ExecStart=/opt/cliente/node/bin/node /opt/cliente/current/dist/server.js
Environment=CLIENTE_ENV_FILE=/etc/cliente/.env
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cliente

[Install]
WantedBy=multi-user.target
